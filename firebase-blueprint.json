{
  "entities": {
    "User": {
      "title": "User",
      "description": "Learning profile, stats, energy, streak, and equipment for an English learner",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique Firebase Auth UID of the user",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "description": "Display name of the learner",
          "maxLength": 30
        },
        "avatarUrl": {
          "type": "string",
          "description": "Data URL or avatar image identifier",
          "maxLength": 100000
        },
        "energy": {
          "type": "number",
          "description": "Current energy (⚡️) balance"
        },
        "streak": {
          "type": "number",
          "description": "Daily streak count"
        },
        "lastDailyDate": {
          "type": "string",
          "description": "Last completed daily cycle date string (YYYY-MM-DD)",
          "maxLength": 20
        },
        "completedSessions": {
          "type": "number",
          "description": "Total number of completed quiz sessions"
        },
        "perfectSessions": {
          "type": "number",
          "description": "Total number of 100% correct quiz sessions"
        },
        "rating": {
          "type": "number",
          "description": "Ranked rating points"
        },
        "rankTier": {
          "type": "string",
          "description": "User rank tier category",
          "enum": ["bronze", "silver", "gold", "platinum", "diamond", "heaven"]
        },
        "equippedMainGoods": {
          "type": "string",
          "description": "Equipped main stationery item",
          "enum": ["pencil", "marker"]
        },
        "equippedSubGoods": {
          "type": "string",
          "description": "Equipped sub stationery item",
          "enum": ["eraser", "ruler", "hat"]
        },
        "unlockedGoods": {
          "type": "array",
          "description": "List of unlocked goods IDs"
        },
        "lastActive": {
          "type": "number",
          "description": "Timestamp of user's last activity in milliseconds"
        },
        "isOnline": {
          "type": "boolean",
          "description": "Whether the user is currently online"
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp when profile was created"
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp of last profile update"
        }
      },
      "required": ["userId", "userName", "energy", "streak", "rating", "rankTier"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Health check connection document",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Connection test status"
        }
      }
    },
    "Presence": {
      "title": "Presence",
      "description": "Real-time online presence and daily login record in Firebase",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "maxLength": 32
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 100000
        },
        "rating": {
          "type": "number"
        },
        "rankTier": {
          "type": "string"
        },
        "lastActive": {
          "type": "number"
        },
        "lastLoginDate": {
          "type": "string",
          "maxLength": 20
        },
        "isOnline": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["userId", "userName", "lastActive", "lastLoginDate", "isOnline"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Learner profile and synchronized game state"
    },
    "/presence/{userId}": {
      "schema": "Presence",
      "description": "Learner presence status (currently online and today's logins)"
    },
    "/test/connection": {
      "schema": "TestConnection",
      "description": "Health check document for initial connection testing"
    }
  }
}
